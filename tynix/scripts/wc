#!/bin/sh
# wc [-l] [-w] [-c] [FILE...]    count lines, words and characters (stdin with no file)
#
# With no option all three are printed; with several files a total follows.
# Limits of a script: the characters are the line lengths plus one newline a
# line (a last line without its newline counts one too many), and a word that
# has * ? or [ in it and matches a file name is counted as the files it matches.
lines=1 words=1 chars=1
if [ "$1" = -l ] || [ "$1" = -w ] || [ "$1" = -c ]; then
    lines= words= chars=
    while [ "$1" = -l ] || [ "$1" = -w ] || [ "$1" = -c ]; do
        case $1 in -l) lines=1 ;; -w) words=1 ;; -c) chars=1 ;; esac
        shift
    done
fi
tl=0 tw=0 tc=0
show() {
    local out=
    [ -n "$lines" ] && out=$1
    [ -n "$words" ] && out="${out:+$out }$2"
    [ -n "$chars" ] && out="${out:+$out }$3"
    echo "$out${4:+ $4}"
}
count() {
    l=0 w=0 c=0
    while read -r line || [ -n "$line" ]; do
        l=$((l + 1))
        c=$((c + ${#line} + 1))
        for word in $line; do w=$((w + 1)); done
    done
}
if [ $# -eq 0 ]; then
    count
    show $l $w $c ""
    exit 0
fi
status=0
for f in "$@"; do
    if [ ! -f "$f" ]; then
        echo "wc: $f: not a file"
        status=1
        continue
    fi
    count < "$f"
    show $l $w $c "$f"
    tl=$((tl + l)) tw=$((tw + w)) tc=$((tc + c))
done
[ $# -gt 1 ] && show $tl $tw $tc total
exit $status
