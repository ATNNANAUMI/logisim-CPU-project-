#!/bin/sh
# tail [-n N] [FILE...]    the last N lines (default 10) of each file, or of stdin
#
# N is at most 100 (the lines are kept in shell variables, of which there are
# 128). With several files each starts with a line "==> NAME <==". Leading
# spaces and tabs of a line are lost: `read` takes them off.
n=10
if [ "$1" = -n ]; then
    n=$2
    shift 2
fi
case $n in
    ''|*[!0-9]*) echo "tail: bad number: $n"; exit 2 ;;
esac
if [ $n -gt 100 ]; then
    echo "tail: at most 100 lines"
    exit 2
fi
last() {
    local count=0 line i start total v
    [ $n -eq 0 ] && return 0
    while read -r line || [ -n "$line" ]; do
        eval "t$((count % n))=\$line"
        count=$((count + 1))
    done
    total=$count
    start=0
    if [ $count -gt $n ]; then
        total=$n
        start=$((count % n))
    fi
    i=0
    while [ $i -lt $total ]; do
        eval "v=\$t$(((start + i) % n))"
        echo "$v"
        i=$((i + 1))
    done
}
if [ $# -eq 0 ]; then
    last
    exit 0
fi
status=0
for f in "$@"; do
    if [ ! -f "$f" ]; then
        echo "tail: $f: not a file"
        status=1
        continue
    fi
    [ $# -gt 1 ] && echo "==> $f <=="
    last < "$f"
done
exit $status
